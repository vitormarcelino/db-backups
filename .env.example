DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
# DB_NAMES=database1,database2,database3  # Opcional: se não especificado, faz backup de todos os databases

# Modo de backup: host (pg_dump local conectando em DB_HOST) ou docker (pg_dump dentro de cada container)
BACKUP_MODE=host
# DOCKER_CONTAINERS=postgres-app1,postgres-app2  # Opcional: se omitido, detecta containers PostgreSQL em execução

STORAGE_PROVIDER=s3

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-backup-bucket

# GCS (usado quando STORAGE_PROVIDER=gcs)
# GCS_BUCKET_NAME=your-backup-bucket
# GCS_PROJECT_ID=your-gcp-project
# GCS_CREDENTIALS_FILE=/caminho/para/service-account.json  # Opcional: se omitido, usa Application Default Credentials
# GCS_STORAGE_CLASS=NEARLINE  # STANDARD, NEARLINE, COLDLINE ou ARCHIVE

BACKUP_RETENTION_DAYS=15
LOG_LEVEL=INFO

# Nome do servidor (opcional - usa hostname se não especificado)
SERVER_NAME=server1